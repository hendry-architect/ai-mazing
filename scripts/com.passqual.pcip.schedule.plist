<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Fires scripts/pcip-scheduled-agent.sh Monday, Wednesday, Friday at 08:00.
  launchd, not cron: cron does not run while the Mac is asleep, and a
  practice laptop is asleep most nights. launchd fires the job at the next
  wake if the machine was asleep at the scheduled time, so a missed 08:00
  still happens instead of silently vanishing.

  pcip-scheduled-agent.sh, not pcip-scheduled-post.sh (changed 2026-09-14):
  the older script forced PCIP_CANVA_MODE=connect so a plain bash job could
  finish unattended, but that mode's free autofill quota is a one-time
  trial that does not reset and requires Canva Enterprise to lift. The
  agent-driven script instead runs `claude -p` non-interactively, which
  fulfils Canva handoffs itself with ordinary design/export tools —
  verified end-to-end the same day, including a real handoff fulfilled and
  a real WordPress draft published, entirely unattended.

  Install (see pcip/SETUP.md Phase 8 for the full walkthrough):
    cp scripts/com.passqual.pcip.schedule.plist ~/Library/LaunchAgents/
    # edit the two REPLACE_WITH_REPO_PATH lines in the copy first
    launchctl load ~/Library/LaunchAgents/com.passqual.pcip.schedule.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.passqual.pcip.schedule.plist
    rm ~/Library/LaunchAgents/com.passqual.pcip.schedule.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.passqual.pcip.schedule</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_REPO_PATH/scripts/pcip-scheduled-agent.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_REPO_PATH</string>

  <!-- FIXED 2026-09-15: launchd's Weekday follows cron's convention — 0 or 7
       is Sunday, 1 is Monday, ... 6 is Saturday (Apple's launchd.plist(5)
       man page). The previous values (2/4/6) were entered as if Sunday=1,
       which made this job fire Tuesday/Thursday/Saturday, not
       Monday/Wednesday/Friday. Found live: the only post that ever went out
       landed on a Saturday, then nothing for three days once Sun/Mon (not
       real fire days under the bug) passed silently. Mon=1, Wed=3, Fri=5.
       Three separate dictionaries, not one with a Weekday array, because
       launchd only accepts one Hour/Minute pair per StartCalendarInterval
       entry. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>REPLACE_WITH_REPO_PATH/pcip_data/schedule/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_REPO_PATH/pcip_data/schedule/launchd.err.log</string>

  <!-- launchd starts with a minimal environment: no PATH entries for
       Homebrew's python or claude, no HOME reliably set the way a login
       shell has it. The script resolves both by absolute path, so it does
       not depend on PATH — this just keeps HOME sane for anything that does.

       PCIP_SCHEDULE_LIVE=1: without it, every scheduled run would only
       ever produce a WordPress draft — invisible on the live site, the
       exact "no new posts" problem this automation exists to solve. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>REPLACE_WITH_HOME_PATH</string>
    <key>PCIP_SCHEDULE_LIVE</key>
    <string>1</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
