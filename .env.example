# .env.example — AI-mazing Analyst
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env (which is gitignored) and fill in real values, OR
# export the variables in your shell before running Streamlit:
#
#   export AMPLITUDE_API_KEY=your_key_here
#   export AMPLITUDE_SECRET_KEY=your_secret_here
#   streamlit run app.py
#
# For Streamlit Cloud: add these under App Settings → Secrets as TOML, e.g.:
#   AMPLITUDE_API_KEY     = "your_key_here"
#   AMPLITUDE_SECRET_KEY  = "your_secret_here"
#
# Find your API credentials in Amplitude:
#   Settings → Projects → [your project] → API Credentials
# ─────────────────────────────────────────────────────────────────────────────

# Required — Amplitude project API key (public identifier)
AMPLITUDE_API_KEY=your_amplitude_api_key_here

# Required — Amplitude project secret key (treat like a password)
AMPLITUDE_SECRET_KEY=your_amplitude_secret_key_here

# Optional — Amplitude app/project ID (used in status messages only).
# Leave blank to auto-detect from the API key's associated project.
AMPLITUDE_PROJECT_ID=

# Optional — set to "eu" if your Amplitude org is on the EU data centre.
# Leave blank (or "us") for the default US region.
AMPLITUDE_REGION=us

# ─────────────────────────────────────────────────────────────────────────────
# PCIP — PassQual Creative Intelligence Platform (see pcip/README.md)
# Every section below is optional; unconfigured connectors are simply
# reported as unavailable by `python -m pcip status`.
# ─────────────────────────────────────────────────────────────────────────────

# Where the knowledge graph and exports live (gitignored)
PCIP_DATA_DIR=pcip_data

# Canva Connect API — create an integration at https://www.canva.com/developers/
# Scopes: design:meta:read design:content:read design:content:write
#         folder:read asset:read brandtemplate:meta:read brandtemplate:content:read
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_ACCESS_TOKEN=
CANVA_REFRESH_TOKEN=

# Anthropic — copy generation (headlines, captions, CTA, hashtags, alt-text)
ANTHROPIC_API_KEY=
PCIP_ANTHROPIC_MODEL=claude-sonnet-5

# WordPress (passqual.com). Self-hosted: user + application password.
# WordPress.com-hosted: bearer token instead.
WORDPRESS_URL=https://passqual.com
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
WORDPRESS_COM_TOKEN=

# Social publishing — Buffer token alone covers every profile connected in
# Buffer; Meta/LinkedIn tokens enable direct publishing.
BUFFER_TOKEN=
META_PAGE_TOKEN=
META_IG_USER_ID=
LINKEDIN_TOKEN=
LINKEDIN_ORG_URN=

# Review gates that may auto-approve (comma-separated). medical_review can
# NEVER be auto-approved regardless of this setting.
PCIP_AUTO_APPROVE_GATES=
PCIP_DEFAULT_BRAND=PassQual
